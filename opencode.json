{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-rocm/qwen3.8-27b",
  "small_model": "local-rocm/qwen3.8-27b",
  "instructions": [
    ".github/copilot-instructions.md"
  ],
  "tools": {
    "shell": true,
    "skill": true,
    "execute": false,
    "read": false,
    "write": false,
    "edit": false,
    "patch": false,
    "grep": false,
    "glob": false,
    "list": false,
    "webfetch": false,
    "websearch": false,
    "todowrite": false,
    "todoread": false,
    "task": false,
    "question": false
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "provider": {
    "local-rocm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local ROCm (RX 9070 XT)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "sk-local",
        "timeout": 900000
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8-27B (65K)",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    }
  }
}
